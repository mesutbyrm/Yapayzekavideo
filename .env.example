# =====================================================================
# AI Social Factory – ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun. .env ASLA git'e eklenmez.
# Boş bırakılan opsiyonel entegrasyonlar panelde "Yapılandırılmadı" olarak görünür;
# sistem çökmez, ilgili adım açık bir hata ile atlanır (sahte başarı üretilmez).
# =====================================================================

# --- Genel ---
NODE_ENV=production
DOMAIN=panel.ornek.com
APP_URL=https://panel.ornek.com
# Platformların videoyu çektiği adres (STORAGE_DRIVER=local iken). Boşsa APP_URL kullanılır.
PUBLIC_MEDIA_BASE_URL=
LOG_LEVEL=info

# --- Veritabanı / Redis (docker-compose bu değerlerden bağlantı adreslerini üretir) ---
POSTGRES_USER=asf
POSTGRES_PASSWORD=            # openssl rand -base64 24
POSTGRES_DB=asf
REDIS_PASSWORD=               # openssl rand -base64 24
# Docker dışında çalıştırırken (geliştirme):
# DATABASE_URL=postgresql://asf:<şifre>@localhost:5432/asf
# REDIS_URL=redis://localhost:6379

# --- Güvenlik (ZORUNLU, üretimde eksikse servisler başlamaz) ---
TOKEN_ENCRYPTION_KEY=         # openssl rand -base64 32  (AES-256-GCM, OAuth token şifreleme)
TOKEN_ENCRYPTION_KEY_PREVIOUS= # anahtar rotasyonunda eski anahtar
SESSION_SECRET=               # openssl rand -base64 48
MEDIA_SIGNING_SECRET=         # openssl rand -base64 48
SESSION_TTL_HOURS=168

# --- İlk yönetici (yalnızca seed sırasında okunur; seed sonrası .env'den silebilirsiniz) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=               # en az 12 karakter, büyük/küçük harf ve rakam
SEED_BRAND_NAME=İlk Marka

# --- OpenAI (senaryo + moderasyon + opsiyonel görsel) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_INPUT_PRICE_PER_1M=0.25
OPENAI_OUTPUT_PRICE_PER_1M=2.00
AI_IMAGES_ENABLED=false
AI_IMAGE_PRICE_USD=0.011

# --- Google Cloud Text-to-Speech ---
# Servis hesabı JSON'unun tek satır içeriği VEYA dosya yolu (konteynere bağlanmalı)
GOOGLE_TTS_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TTS_PRICE_PER_1M_CHARS=16

# --- Lisanslı stok medya (ücretsiz anahtarlar) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Depolama ---
STORAGE_DRIVER=r2             # r2 (önerilen) | local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=           # ör. https://media.ornek.com (bucket'a bağlı özel alan adı). Boşsa süreli imzalı URL kullanılır.
R2_PRICE_PER_GB_MONTH=0.015
SERVER_MONTHLY_COST_USD=0     # maliyet raporu için sabit sunucu gideri (bütçe sınırına sayılmaz)

# --- Video işleme ---
RENDER_CONCURRENCY=1
FFMPEG_THREADS=2
FFMPEG_TIMEOUT_SEC=600
SUBTITLE_FONT=DejaVu Sans
WORKER_MEM_LIMIT=3g
WORKER_CPUS=2

# --- Meta (Instagram Reels + Facebook Reels) ---
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# --- TikTok (Content Posting API – Direct Post) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok uygulama denetimi tamamlanana kadar false bırakın: yalnızca SELF_ONLY (özel) paylaşım yapılır.
TIKTOK_DIRECT_POST_AUDITED=false

# --- YouTube (Google OAuth – YouTube Data API v3) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- E-posta bildirimleri ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AI Social Factory <no-reply@ornek.com>
ALERT_EMAIL=

# --- Yedekleme ---
BACKUP_TIME=00:30             # UTC (İstanbul 03:30)
BACKUP_RETENTION_DAYS=14
BACKUP_INCLUDE_MEDIA=false    # STORAGE_DRIVER=local ise true yapın
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=           # ör. https://<account_id>.r2.cloudflarestorage.com
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
