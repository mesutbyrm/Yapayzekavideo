    "@google-cloud/text-to-speech": "7.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "bullmq": "6.7.7",
    "ioredis": "5.11.1",
    "luxon": "3.7.2",
    "nodemailer": "7.0.13",
    "openai": "6.49.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "3.7.6",
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.12",
    "@types/pg": "8.23.1",
    "dotenv": "17.4.2",
